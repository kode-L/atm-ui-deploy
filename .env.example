# Reown (WalletConnect) Cloud project ID — get one at https://cloud.reown.com
# Required for the wallet-connect modal (lib/reown/appkit.ts) to work.
NEXT_PUBLIC_REOWN_PROJECT_ID="your_project_id_here"

# Deployed contract addresses (BNB Smart Chain Testnet) — used as fallback defaults
# in lib/contracts/config.ts when nothing is saved yet in localStorage. These env vars are
# optional local overrides; lib/contracts/chain.json is the checked-in per-chain manifest
# and is used when a var here is unset (see chain.json's "97"/"56" entries).
NEXT_PUBLIC_TOKEN_ADDRESS="0x51E6Ac1533032E72e92094867fD5921e3ea1bfa0"
NEXT_PUBLIC_HUB_ADDRESS="your_gamehub_address_here"
NEXT_PUBLIC_TOKEN_VOID_ADDRESS="0xbA664Eb753bD75cE86EF1F0B651ABF4Ad0D9C30A"

# Pre-fills the Admin Address field on the Deploy tab's GameHub form (first deployment
# convenience only — not read anywhere else). Set to your deployer wallet address.
NEXT_PUBLIC_ADMIN_ADDRESS="your_admin_wallet_address_here"

# Optional: also treat this wallet as the Void contract's owner in the dashboard (Void tab),
# in addition to whatever the live owner() call returns. The Add Burn Type button is always
# shown regardless — this only affects the "IS the owner" banner/warning text and other
# owner-gated sections (Owner Actions). The on-chain onlyOwner check still has final say;
# an address here that isn't the real owner will still get a revert on write calls.
NEXT_PUBLIC_VOID_OWNER_ADDRESS="your_void_owner_wallet_address_here"

# Same set of defaults, but for BSC Mainnet (chain ID 56) — deployments are independent
# per network, so a mainnet deployment needs its own addresses here. The app tracks
# testnet/mainnet addresses separately in localStorage; switch networks from the wallet
# button and these seed the fallback defaults for whichever network is connected.
NEXT_PUBLIC_TOKEN_ADDRESS_MAINNET="your_token_address_here"
NEXT_PUBLIC_HUB_ADDRESS_MAINNET="your_gamehub_address_here"
NEXT_PUBLIC_TOKEN_VOID_ADDRESS_MAINNET="your_tokenvoid_address_here"
NEXT_PUBLIC_ADMIN_ADDRESS_MAINNET="your_admin_wallet_address_here"
NEXT_PUBLIC_VOID_OWNER_ADDRESS_MAINNET="your_void_owner_wallet_address_here"
